{
  "name": "morningquest-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm-run-all -p typecheck build-only",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@types/three": "^0.185.3",
    "@types/webxr": "^0.5.24",
    "@zxing/browser": "0.2.1",
    "pinia": "3.0.4",
    "three": "^0.185.1",
    "vue": "3.5.40",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "29.1.1",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
